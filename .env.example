# SKIA Environment Variables
# Copiar este archivo a .env y configurar valores

# ============================================
# DATABASE (PostgreSQL existente)
# ============================================
DB_HOST=global_postgres_db
DB_PORT=5432
DB_NAME=skia_db
DB_USER=postgres
DB_PASSWORD=cambiar_esta_contraseña
DATABASE_URL=postgresql://postgres:cambiar_esta_contraseña@global_postgres_db:5432/skia_db?sslmode=disable

# ============================================
# JWT CONFIGURATION
# ============================================
# Generar con: openssl rand -base64 32
JWT_SECRET=cambiar_esto_por_un_secreto_largo_y_aleatorio_de_32_caracteres
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ============================================
# APPLICATION
# ============================================
APP_ENV=production
APP_PORT=8080
LOG_LEVEL=info

# ============================================
# FRONTEND
# ============================================
NEXT_PUBLIC_API_URL=http://localhost:8080/v1
NODE_ENV=production

# ============================================
# DOMAIN (para nginx)
# ============================================
DOMAIN=tu-dominio.com
API_SUBDOMAIN=api
WEB_SUBDOMAIN=app
